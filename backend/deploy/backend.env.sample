# /etc/kidbuddy/backend.env
# 上线前把这些改掉。SECURE 和 PUBLIC_ORIGIN 是上了 HTTPS 之后必须开的。

KB_DB=/var/lib/kidbuddy/kb.db
KB_HOST=127.0.0.1
KB_PORT=8080

# 1 = 会话 cookie 带 Secure；只有走 HTTPS 时才开
KB_SECURE=1
# 前端地址，用来挡跨站请求。留空则不检查 Origin
KB_PUBLIC_ORIGIN=https://kid.example.com

# 板子连的 broker（TCP）
KB_BROKER=123.56.1.47:1883
# 家长网页连的 broker（浏览器只能走 WebSocket）。经 nginx 终结 TLS 时用 wss://域名/mqtt
KB_WS_URL=wss://kid.example.com/mqtt

# 家长端静态文件目录
KB_STATIC=/opt/kidbuddy/phone-app
