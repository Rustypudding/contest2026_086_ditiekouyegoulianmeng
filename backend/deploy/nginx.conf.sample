# nginx 片段：静态页面 + 账号接口 + MQTT over WebSocket
# 证书用 Let's Encrypt（certbot --nginx）即可，没有域名就先别上公网。

server {
    listen 80;
    server_name kid.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name kid.example.com;

    ssl_certificate     /etc/letsencrypt/live/kid.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/kid.example.com/privkey.pem;

    # 家长端网页
    root /opt/kidbuddy/phone-app;
    index index.html;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # 账号接口
    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 30s;
        client_max_body_size 64k;
    }

    # 家长网页的 MQTT（WebSocket）→ mosquitto 的 websockets 监听
    # mosquitto.conf 里对应：listener 8083 / protocol websockets
    location /mqtt {
        proxy_pass http://127.0.0.1:8083;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }

    # 企业端（可选，建议再套一层 IP 白名单或 VPN）
    location /admin/ {
        alias /opt/kidbuddy/backend/admin/;
        index admin.html;
    }
}
