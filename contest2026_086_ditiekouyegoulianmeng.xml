<?xml version='1.0' encoding='UTF-8'?>
<manifest>
  <!--
    Team repo manifest. Includes the full openvela base project set
    (openvela.xml in this same repo) and adds this team repo as a self-ref
    project, exposing its subdirectories to openvela working-tree locations.
    remote/default come from the included openvela.xml.
  -->
  <include name="openvela.xml"/>

  <project path="contest2026_086_ditiekouyegoulianmeng" name="contest2026_086_ditiekouyegoulianmeng">
    <!-- kid_buddy: AI 儿童陪伴应用（本队作品主体） -->
    <linkfile src="app/kid_buddy" dest="packages/demos/contest2026_086_kid_buddy"/>

    <!--
      上游依赖：本作品对 packages/ai_agent 和 vendor/allwinnertech 的功能改动，
      两个上游仓的 PR 都还在评审队列里（CODEOWNERS 闸门，参赛者合不了自己的 PR），
      而 openvela.xml 里这两个 project 没有 pin revision，走的是 openvela 默认分支。
      所以这里把改动过的文件用 <copyfile> 覆盖到工作区里，让 repo sync 之后的树
      就等于我们出固件用的那棵树 —— 直接 repo init / repo sync / build.sh 就能编。

      必须是 <copyfile>，不能换成 <linkfile>：linkfile 在目标位置已经存在同名
      普通文件时不会覆盖（repo 的 removedirs() 只清 symlink 和空目录，遇到普通
      文件就停下），链接失败只在日志里报一行 error，树里留的还是上游原文件。
      这 42 个目标里有 38 个是上游本来就有的文件，用 linkfile 会静默失效。

      文件内容是这两个仓合入我们 PR 之后的状态；PR 合了就可以把这份删掉。
    -->

    <!-- ==== packages/ai_agent（39 个文件）==== -->
